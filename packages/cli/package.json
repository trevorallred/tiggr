{
  "name": "@tiggr/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "tiggr": "./build/cli.js"
  },
  "exports": {
    ".": {
      "types": "./build/cli.d.ts",
      "import": "./build/cli.js"
    }
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=build/cli.js",
    "clean": "rm -rf build && rm -f tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "tiggr": "workspace:*",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
