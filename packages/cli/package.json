{
  "name": "tigger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "tigger": "./build/cli.js"
  },
  "exports": {
    ".": {
      "types": "./build/cli.d.ts",
      "import": "./build/cli.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf build && rm -f tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tigger/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
